# Local development defaults. Copy to .env.local or export values in your shell.
AETHER_HOST=127.0.0.1
AETHER_PORT=3030
AETHER_WEB_HOST=127.0.0.1
AETHER_API_PROXY_HOST=127.0.0.1
AETHER_MEDIA_ROOTS=./media
AETHER_CONFIG_DIR=./config
AETHER_CACHE_DIR=./cache

# Debounced local file watching. Disable for unstable network mounts or very large trees.
AETHER_WATCH_ENABLED=true
AETHER_WATCH_DEBOUNCE_MS=2000

# Optional local AI tag suggestions. Disabled by default; no cloud provider is configured.
AETHER_AI_PROVIDER=disabled
AETHER_OLLAMA_BASE_URL=http://127.0.0.1:11434
AETHER_OLLAMA_VISION_MODEL=llava:latest
AETHER_AI_TIMEOUT_MS=45000

# Generate with:
# npm run hash-password -w @aether/server -- "your password"
AETHER_PASSWORD_HASH=

# Generate with:
# openssl rand -base64 48
AETHER_SESSION_SECRET=

# Persistent failed-login throttling, stored in local SQLite.
AETHER_LOGIN_MAX_ATTEMPTS=10
AETHER_LOGIN_WINDOW_MINUTES=15
AETHER_LOGIN_LOCKOUT_MINUTES=15

# Keep false for plain local HTTP. Set true only behind HTTPS.
AETHER_COOKIE_SECURE=false

# Set true only when Aether is behind a trusted local reverse proxy.
AETHER_TRUST_PROXY=false
