{
  "name": "@aether/server",
  "version": "0.1.0",
  "description": "Aether local media API server.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "node native/build.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node native/build.mjs && vitest run",
    "backup": "tsx src/cli/backup.ts",
    "data:status": "tsx src/cli/data.ts status",
    "data:rebuild": "tsx src/cli/data.ts rebuild",
    "data:restore": "tsx src/cli/data.ts restore",
    "data:wipe": "tsx src/cli/data.ts wipe",
    "data:recover": "tsx src/cli/data.ts recover",
    "hash-password": "tsx src/cli/hash-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.6",
    "argon2": "^0.44.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
