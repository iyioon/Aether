# Copy this file to aether-data/private.env.
AETHER_HOST=127.0.0.1
AETHER_PORT=3030
AETHER_MEDIA_ROOTS=library=./media

# Disable watching for unstable network mounts or very large libraries.
AETHER_WATCH_ENABLED=true
AETHER_WATCH_DEBOUNCE_MS=2000

# Optional local AI tag suggestions. Disabled by default.
AETHER_AI_PROVIDER=disabled
AETHER_OLLAMA_BASE_URL=http://127.0.0.1:11434
AETHER_OLLAMA_VISION_MODEL=llava:latest
AETHER_AI_TIMEOUT_MS=45000

# Run this command and follow its hidden prompt:
# npm run hash-password -w @aether/server
AETHER_PASSWORD_HASH=

# Generate with: openssl rand -base64 48
AETHER_SESSION_SECRET=
AETHER_SESSION_TTL_DAYS=14

AETHER_LOGIN_MAX_ATTEMPTS=10
AETHER_LOGIN_WINDOW_MINUTES=15
AETHER_LOGIN_LOCKOUT_MINUTES=15

# Use true only when Aether is served over HTTPS.
AETHER_COOKIE_SECURE=false

# Use true only behind a trusted reverse proxy.
AETHER_TRUST_PROXY=false
